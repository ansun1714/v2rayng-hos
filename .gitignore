# ── 鸿蒙构建产物 ─────────────────────────────────────────
**/build/
**/.hvigor/
**/.cxx/
**/node_modules/
**/oh_modules/
*.hap
*.p7b
*.p12
*.cer
*.har

# ── 本机环境与私有数据（克隆后自己补） ───────────────────
# SDK 路径因机器而异
app/local.properties
# 内置节点列表：仓库只保留示例，真实节点不要提交
app/entry/src/main/resources/rawfile/nodes.txt
# geoip / geosite 数据随仓库分发（约 28MB，来自 Loyalsoldier/v2ray-rules-dat），
# 否则 CI 与 clone 后的构建都会缺分流数据，故不再忽略
# 个人版专属背景图（只在本地构建里用，不进公开仓库）
app/entry/src/main/resources/base/media/personal_bg.png
app/entry/src/main/resources/base/media/personal_icon.png
app/AppScope/resources/base/media/personal_icon.png

# ── 运行时数据快照 ──────────────────────────────────────
app/profiles.json
app/state.json
app/rules.json
app/rules-src.txt

# ── Go 内核编译中间产物 ─────────────────────────────────
core-native/*.so
core-native/*.bak

# ── 本地参考用的上游源码（约 166MB，仅本机比对，不入库） ──
/upstream/

# ── 本机临时文件（调试脚本、截图、测试夹具、日志） ──────
/_*
/*.jpeg
/*.jpg
/*.png
/*.log
/*.txt
/*.json
sub.txt
direct*.txt
big.txt
rules.yaml
